{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasatch-intel",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server/entry.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wasatch-intel-db",
      "database_id": "8a8792c9-df0b-4644-8fdb-5ecfc5d6a66a"
    }
  ],
  "triggers": {
    // Watchlist alert cron — runs every hour at :00
    "crons": ["0 * * * *"]
  }
}
